+		if (cfg->load_uA) {
+			ret = regulator_set_load(ctx->regs[i].consumer,
+						 cfg->load_uA);
+			if (ret < 0) {
+				dev_err(ctx->dev,
+					"Failed to set %s load to %u uA: %d\n",
+					ctx->regs[i].supply, cfg->load_uA, ret);
+				goto err_unvote;
