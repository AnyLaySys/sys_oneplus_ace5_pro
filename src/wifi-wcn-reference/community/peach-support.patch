+	len = snprintf(msg, sizeof(msg),
+		       "{class: wlan_pdc, ss: %s, res: %s.v, %s: %u}",
+		       pdc, rail, sequence, voltage);
+	if (len >= sizeof(msg))
+		return -E2BIG;
+
+	return pwrseq_qcom_wcn_qmp_send(ctx, msg);
